@model IEnumerable<TechStoreCatalog.Models.ProductItem>

@{
    ViewBag.Title = "Tech Store";
}

<h2>Tech Store Catalog</h2>

<table border="1" cellpadding="10" cellspacing="0">
    <tr>
        <th>Product</th>
        <th>Category</th>
        <th>Price</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category</td>
            <td>₹@item.Price</td>
            <td>
                @Html.ActionLink(
                    "View",
                    "Details",
                    "Catalog",
                    new { id = item.Id },
                    null
                )
            </td>
        </tr>
    }
</table>